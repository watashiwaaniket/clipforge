# Backend
DATABASE_URL=postgresql+psycopg://clipforge:clipforge@db:5432/clipforge
REDIS_URL=redis://redis:6379/0

# Fernet key. start.sh fills a blank value.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# HS256 secret shared with Auth.js. start.sh fills a blank value.
JWT_SECRET=

STORAGE_DIR=/storage

# Reject VODs longer than this (MVP guardrail).
MAX_VOD_MINUTES=240
MAX_CLIPS_PER_JOB=8
MAX_CONCURRENT_JOBS=3
MAX_JOBS_PER_DAY=10
JOB_TIMEOUT_SECONDS=2700
MIN_FREE_DISK_BYTES=8589934592

# Leave 'en' for English; set empty (WHISPER_LANGUAGE=) to auto-detect.
WHISPER_LANGUAGE=en

# Number of trusted reverse proxies in front of the API (set 1 behind Caddy in prod).
TRUST_PROXY_COUNT=0

# Comma-separated browser origins. Never "*".
CORS_ORIGINS=http://localhost:3000

# Whisper server-side fallback. Optional. User BYOK is primary — this is not a user key.
OPENAI_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
